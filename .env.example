# ═══════════════════════════════════════════════════════════
#  FaceTrace — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit your .env to git.
# ═══════════════════════════════════════════════════════════

# ── 1. SerpApi (reverse image search) ───────────────────────
# Free plan: 100 searches/month at https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# ── 2. Wallet Private Key ────────────────────────────────────
# Export from MetaMask: click ⋮ → Account Details → Show Private Key
# Use a FRESH testnet-only wallet. Never use your main wallet here.
ETH_PRIVATE_KEY=0xyour_private_key_here

# ── 3. RPC URL (OPTIONAL — public endpoint used by default) ──
# The app uses the free Polygon Amoy public RPC by default.
# You do NOT need to set this unless the public RPC is slow for you.
# Free alternative from Alchemy: https://alchemy.com → Create App → Polygon Amoy
# ETH_RPC_URL=https://rpc-amoy.polygon.technology

# ── 4. Contract Address (fill after first run) ───────────────
# Leave blank on first run — the app deploys it automatically.
# After first run, copy the address from contract_data.json here
# to skip redeployment on future runs (faster + saves gas).
ETH_CONTRACT_ADDRESS=

# ── 5. Optional: tune face matching ─────────────────────────
# Lower = stricter match (default 0.45 is good for most cases)
# FACE_MATCH_TOLERANCE=0.45
